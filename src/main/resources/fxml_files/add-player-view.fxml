<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="1020.0" prefWidth="1020.0" spacing="10.0" style="-fx-border-color: #9c7945; -fx-border-width: 2;" styleClass="add-player" stylesheets="@../stylesheets/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="raffle.controllers.AddPlayerController">
    <padding>
        <Insets bottom="10.0" left="5.0" right="5.0" top="5.0" />
    </padding>
    <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="1.0" left="1.0" right="1.0" top="1.0" />
        </padding>
        <VBox.margin>
            <Insets bottom="1.0" left="1.0" right="1.0" top="1.0" />
        </VBox.margin>
        <TableView fx:id="playerTable" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="IDColumn" prefWidth="50.0" text="%player.col.id" />
                <TableColumn fx:id="nameColumn" prefWidth="400.0" text="%player.col.name" />
                <TableColumn fx:id="phoneNumberColumn" minWidth="0.0" prefWidth="380.0" text="%player.col.phone" />
                <TableColumn fx:id="numberOfTicketsColumn" minWidth="0.0" prefWidth="168.0" text="%player.col.tickets" />
            </columns>
            <HBox.margin>
                <Insets bottom="1.0" left="1.0" right="1.0" top="1.0" />
            </HBox.margin>
            <padding>
                <Insets bottom="1.0" left="1.0" right="1.0" top="1.0" />
            </padding>
        </TableView>
    </HBox>
    <HBox alignment="CENTER" maxHeight="75.0" prefHeight="75.0" spacing="10.0" styleClass="h-box" VBox.vgrow="ALWAYS">
        <Label id="ID" fx:id="ticketsLeft" alignment="CENTER" minWidth="150.0" text="%player.label.left" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
        <TextField fx:id="playerName" promptText="%player.col.name" HBox.hgrow="ALWAYS">
            <HBox.margin>
                <Insets />
            </HBox.margin>
        </TextField>
        <TextField fx:id="phoneNumber" promptText="%player.col.phone" HBox.hgrow="ALWAYS" />
        <TextField fx:id="numberOfTickets" promptText="%player.col.tickets" HBox.hgrow="ALWAYS" />
    </HBox>
    <FlowPane alignment="CENTER" hgap="40.0" vgap="8.0" styleClass="h-box" VBox.vgrow="NEVER">
        <Button fx:id="addPlayerButton" onAction="#handleAddPlayer" text="%player.btn.add" />
        <Button fx:id="removePlayerButton" onAction="#handleRemovePlayer" text="%player.btn.remove" />
        <Button fx:id="clearFieldsButton" onAction="#clearFields" text="%player.btn.clear" />
        <Button fx:id="refreshButton" onAction="#handleRefresh" text="%player.btn.refresh" textAlignment="CENTER" />
    </FlowPane>
</VBox>
