<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefWidth="1040.0" style="-fx-border-color: #9c7945; -fx-border-width: 2;" styleClass="main-view" stylesheets="@../stylesheets/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="raffle.controllers.MainViewController">
    <HBox fx:id="dashboard" alignment="CENTER" spacing="14.0" VBox.vgrow="NEVER">
        <padding>
            <Insets bottom="2.0" left="8.0" right="8.0" top="8.0" />
        </padding>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label styleClass="kpi-title" text="%main.kpi.sold" />
            <Label fx:id="soldValue" styleClass="kpi-value, kpi-sold" />
            <ProgressBar fx:id="soldBar" maxWidth="Infinity" prefHeight="10.0" progress="0.0" />
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label styleClass="kpi-title" text="%main.kpi.collected" />
            <Label fx:id="collectedValue" styleClass="kpi-value, kpi-ok" />
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label styleClass="kpi-title" text="%main.kpi.outstanding" />
            <Label fx:id="outstandingValue" styleClass="kpi-value, kpi-warn" />
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label styleClass="kpi-title" text="%main.kpi.potential" />
            <Label fx:id="potentialValue" styleClass="kpi-value, kpi-gold" />
        </VBox>
    </HBox>
    <VBox alignment="CENTER" spacing="5.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
        </padding>
        <VBox.margin>
            <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
        </VBox.margin>
        <TableView fx:id="itemTable" prefHeight="500.0" prefWidth="1000.0" stylesheets="@../stylesheets/styles.css" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn id="image" fx:id="imageColumn" minWidth="150.0" prefWidth="200.0" text="%main.col.image">
                    <cellValueFactory>
                        <PropertyValueFactory property="image" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn id="title" fx:id="titleColumn" minWidth="150.0" prefWidth="240.0" text="%main.col.title">
                    <cellValueFactory>
                        <PropertyValueFactory property="title" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn id="availableTickets" fx:id="ticketsColumn" minWidth="150.0" prefWidth="220.0" text="%main.col.sold">
                    <cellValueFactory>
                        <PropertyValueFactory property="tickets" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn id="ticketPrice" fx:id="priceColumn" minWidth="100.0" prefWidth="140.0" text="%main.col.price">
                    <cellValueFactory>
                        <PropertyValueFactory property="price" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn id="collected" fx:id="collectedColumn" minWidth="120.0" prefWidth="160.0" text="%main.col.collected">
                    <cellValueFactory>
                        <PropertyValueFactory property="title" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
            <padding>
                <Insets bottom="1.0" left="1.0" right="1.0" top="1.0" />
            </padding>
            <VBox.margin>
                <Insets bottom="1.0" left="1.0" right="1.0" top="1.0" />
            </VBox.margin>
        </TableView>
    </VBox>
  <FlowPane alignment="CENTER" hgap="14.0" vgap="8.0" styleClass="h-box" VBox.vgrow="NEVER">
    <Button fx:id="addItemButton" onAction="#handleAddItem" styleClass="button" text="%main.btn.add" />
    <Button fx:id="deleteItemButton" onAction="#handleDeleteItem" styleClass="button" text="%main.btn.delete" />
    <Button fx:id="viewItemButton" onAction="#handleViewItem" styleClass="button" text="%main.btn.view" />
    <Button fx:id="buyTicketsButton" onAction="#handleBuyTickets" styleClass="button" text="%main.btn.buy" />
    <Button fx:id="drawButton" onAction="#handleDraw" styleClass="button" text="%main.btn.draw" />
    <Button fx:id="refreshListButton" onAction="#handleRefreshList" styleClass="button" text="%main.btn.refresh" />
    <Button fx:id="languageButton" onAction="#handleToggleLanguage" styleClass="button" />
    <Button fx:id="themeButton" onAction="#handleToggleTheme" styleClass="button" />
    <VBox.margin>
       <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
    </VBox.margin>
    <padding>
       <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
  </FlowPane>
</VBox>
