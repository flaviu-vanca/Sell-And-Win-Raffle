<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- The StackPane fills the window (or the whole screen in full screen mode). The content is laid out at a fixed
     1000 x 800 and scaled to fit by the controller, so the same screen works in a window and on a projector. -->
<StackPane fx:id="root" prefHeight="800.0" prefWidth="1000.0" style="-fx-border-color: #9c7945; -fx-border-width: 2;"
           styleClass="draw-view" stylesheets="@../stylesheets/styles.css" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="raffle.controllers.DrawController">
    <VBox fx:id="content" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
          minWidth="-Infinity" prefHeight="800.0" prefWidth="1000.0" spacing="14.0">
        <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="10.0"/>
        </padding>
        <HBox alignment="CENTER" spacing="24.0">
            <ImageView fx:id="prizeImage" fitHeight="110.0" fitWidth="170.0" preserveRatio="true"/>
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label fx:id="prizeTitle" styleClass="draw-title"/>
                <Label fx:id="prizeSubtitle" styleClass="draw-subtitle"/>
            </VBox>
        </HBox>
        <Label fx:id="generatedNumber" alignment="CENTER" prefHeight="200.0" prefWidth="560.0" styleClass="draw-number"
               text="?"/>
        <VBox alignment="CENTER" prefHeight="290.0" spacing="6.0" styleClass="draw-panel" VBox.vgrow="ALWAYS">
            <Label fx:id="winerLabel" alignment="CENTER" maxWidth="Infinity" styleClass="draw-winner"
                   textAlignment="CENTER" wrapText="true"/>
            <Label fx:id="winnersListLabel" alignment="CENTER" maxWidth="Infinity" styleClass="draw-winners-list"
                   textAlignment="CENTER"/>
        </VBox>
        <HBox alignment="CENTER" spacing="22.0">
            <Label styleClass="draw-option-label" text="%draw.winnersToDraw"/>
            <Spinner fx:id="winnersSpinner" editable="false" prefWidth="95.0"/>
            <CheckBox fx:id="onePerPerson" selected="true" text="%draw.onePerPerson"/>
        </HBox>
        <HBox alignment="CENTER" spacing="16.0">
            <Button fx:id="checkPlayerStatus" minWidth="-Infinity" onAction="#handleCheckPlayerStatus" text="%draw.btn.status"/>
            <Button fx:id="fullscreenButton" minWidth="-Infinity" onAction="#handleToggleFullscreen" text="%draw.btn.fullscreen"/>
            <Button fx:id="startStopButton" defaultButton="true" minWidth="-Infinity" onAction="#handleStartStop"
                    styleClass="draw-primary" text="%draw.btn.start"/>
        </HBox>
    </VBox>
</StackPane>
